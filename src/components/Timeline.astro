		]
	},
	{ date: "50.000", 
		books: [
			{ title: "No era solo un robo.", description: "Comenzamos a trabajar en el proyecto de la línea de tiempo." },
		]
	},
]

const librosOcaso = [
	{ date: "600.000", 
		books: [
			{ title: "La Raiz", description: "Comenzamos a trabajar en el proyecto de la línea de tiempo." },
		]
	},
	{ date: "700.000", 
		books: [
