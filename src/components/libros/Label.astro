---
const name = Astro.props.label;
---

<div id="label">
	<p>{name}</p>
</div>
<style>
	#label{
		display: flex;
		align-items: center;
		background-color: #ebb3aa;
		color: rgb(0, 0, 0);
		padding: 0.2rem 0.5rem;
		border-radius: 0.25rem;
		height: 1.2rem;
	}
	/*
	#F26F5A rosa
	#6FB394 verde oscuro
	#5AF2AE verde claro
	#9D756F marron
	#64736C gris oscuro
	#483A37 marron oscuro
	*/
</style>
