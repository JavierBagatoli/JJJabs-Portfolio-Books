---
const libros = Astro.props.libros as {
    date: string,
    books: {
        title: string,
        description: string
        }[]
    }[];
---

<div>
	{libros.map((date) => (
		<div id="year-timeline">
			<section id="timeline">
				<p>{date.date} »</p>
			</section>
			<section id="data-timeline">
				{date.books.map((info) => (
					<div id="mini_book">
						<img src="./src/assets/perfil.png" alt="Linea de tiempo" />
						<p class="dm-mono-light">{info.title}</p>
					</div>
				))}
				
			</section>
		</div>
	))}
	
</div>

<style>
	body{
		background-color: #64736C;

	}
	#timeline {
		border-left: black 1px solid;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-left: 0.5rem;
	}
	#container {
		display: flex;
		flex-direction: column;
		padding: 1rem;
		margin-top: 5rem;
	}
	#year-timeline{
		display: flex;
		flex-direction: row;
		gap: 1rem;
		padding-top: 0.3rem;
		align-items: center;
		height: 100%;
	}
	#data-timeline {
		width: auto;
		gap: 1rem;
		border: none;
		display: flex;
		flex-direction: row;
		gap: 0.5rem;
		color: rgb(0, 0, 0);

		padding-right: 1rem;
		height: 3rem;
		gap: 0.9rem;
		img{
			height: 3rem;
			border-radius: 0.4rem 0 0 0.4rem;
			border-right: rgba(0, 0, 0, 0.274) 2px dashed;
		}
	}
	#mini_book{
		display: flex;
		background-color: #68a78e;
		border-radius: 0.4rem;
		flex-direction: row;
		padding-right: 0.5rem;
		gap: 0.5rem;
		width: auto;
		font-family: ;
	}
	/*
	#F26F5A rosa
	#6FB394 verde oscuro
	#5AF2AE verde claro
	#9D756F marron
	#64736C gris oscuro
	#483A37 marron oscuro
	*/
</style>
