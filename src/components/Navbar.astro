---
const nameSeleced = Astro.props.nameSeleced;
---

<div id="navbar">
	<nav>
		<ul>
			<li class={nameSeleced === "home" ? "selected" : ""}><a href="/home-page">Home</a></li>
			<li class={nameSeleced === "libros" ? "selected" : ""}><a href="/">Libros</a></li>
			<li class={nameSeleced === "timeline" ? "selected" : ""}><a href="/time-line">Linea Temporal</a></li>
			<li class={nameSeleced === "universo" ? "selected" : ""}><a href="/universo">Universo</a></li>
		</ul>
	</nav>
</div>

<style>
	nav {
		position: fixed;
		top: 0;
		width: 100vw;
		background-color: #483A37;
		height: 3rem;
		z-index: 100;
	}
	
	a{
		color: white;
	}

	ul{
		display: flex;
		flex-direction: row;
		row-gap: 1rem;
		margin: 0px;
		padding: 0px;

		li{
			list-style: none;
			cursor: pointer;
			
			padding: 0.68rem;
			font-size: 1.2rem;
			a{
				text-decoration: none;
				color: #cac5c5;
				transition: color 0.3s ease;
			}
		}
		li:hover{
			background-color: #2e2727;
		}
	}

	/*
	#F26F5A rosa
	#6FB394 verde oscuro
	#5AF2AE verde claro
	#9D756F marron
	#64736C gris oscuro
	#483A37 marron oscuro
	*/
</style>
