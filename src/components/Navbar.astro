---
const nameSeleced = Astro.props.nameSeleced;

function handleClick(name:string):void {
	console.log(`Has hecho clic en ${name}`);
}
---

<div id="navbar">
	<nav>
		<ul class="pc">
			<li onclick="window.location.href='/'"
				class={nameSeleced === "home" ? "selected" : ""}><a href="/">Home</a></li>
			<li onclick="window.location.href='/books-page'"
				class={nameSeleced === "libros" ? "selected" : ""}><a href="/books-page">Libros</a></li>
			<li onclick="window.location.href='/time-line-page'"
				class={nameSeleced === "timeline" ? "selected" : ""}><a href="/time-line-page">Cronología</a></li>
			<li onclick="window.location.href='/universo-page'"
				class={nameSeleced === "universo" ? "selected" : ""}><a href="/universo-page">Universo</a></li>
		</ul>
		<ul class="mobile">
			<li onclick="window.location.href='/'"
				class={nameSeleced === "home" ? "selected" : ""}><a href="/">🏠</a></li>
			<li onclick="window.location.href='/books-page'"
				class={nameSeleced === "libros" ? "selected" : ""}><a href="/books-page">📖</a></li>
			<li onclick="window.location.href='/time-line-page'"
				class={nameSeleced === "timeline" ? "selected" : ""}><a href="/time-line-page">⌛</a></li>
			<li onclick="window.location.href='/universo-page'"
				class={nameSeleced === "universo" ? "selected" : ""}><a href="/universo-page">💫</a></li>
		</ul>
	</nav>
</div>

<style>
	nav {
		position: fixed;
		top: 0;
		width: 100vw;
		background-color: #483A37;
		height: 2.8rem;
		z-index: 100;
	}
	
	a{
		color: white;
	}

	ul{
		display: flex;
		flex-direction: row;
		row-gap: 1rem;
		margin: 0px;
		padding: 0px;

		li{
			list-style: none;
			cursor: pointer;
			
			padding: 0.68rem;
			font-size: 1.2rem;
			a{
				text-decoration: none;
				color: #cac5c5;
				transition: color 0.3s ease;
			}
		}
		li:hover{
			background-color: #2e2727;
		}
		li.selected{
			background-color: #362e2e;
		}
	}

	.mobile{
		display: none;
	}

	@media screen and (max-width: 500px) {
		.pc{
			display: none;
		}
		.mobile{
			width: 100%;
			display: flex;
			flex-direction: row;
			justify-content: center;
			gap: 1rem;
			filter: grayscale(100%);
			position: fixed;
			bottom: 0;
			top: auto;
		}
		nav{
			position: fixed;
			bottom: 0;
			top: auto;
		}
	}
</style>
