---
import { Image } from "astro:assets";
import Navbar from "../../components/Navbar.astro";

import Layout from "../../layouts/Layout.astro";
import "../index.css";
import { SPECIES } from "../../dataBaseFake/species";

interface iSpecies {
  name: string;
  description: string;
  image: any;
}

export function getStaticPaths() {
  return SPECIES.map((esp: any) => ({
    params: {
      slug: esp.name.toLowerCase().replaceAll(" ", "-"),
    },
    props: {
      esp,
    },
  }));
}

const { esp } = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: `${esp.name} — especie de  JJ Jabs`,
  description: esp.description,
  author: {
    "@type": "Person",
    name: "JJ Jabs",
  },
};
---

<Layout
  title={`${esp.name} | especie de JJ Jabs`}
  description={esp.description}
  canonical={`/books/${esp.name.toLowerCase().replaceAll(" ", "-")}`}
  type="article"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <main>
    <Navbar nameSeleced="" />
    <div id="container" style="display: flex; flex-direction: row;">
      <div
        class="wrap"
        style="gap: 1rem; display: flex; flex-direction: row; justify-content: center;"
      >
        <div>
          <Image
            src={esp.image}
            alt={`Representación visual de los ${esp.name}`}
          />
        </div>
        <div class="card" style="height: fit-content;">
          <h1>{esp.name}</h1>
          <h3>Descripción:</h3>
          <p>{esp.description}</p>
          <h3>Descripción:</h3>
          <p></p>
          <h3>Origen:</h3>
          <p></p>
          <h3>Biología:</h3>
          <p></p>
          <h3>Sociedad y cultura:</h3>
          <p></p>
          <h3>Tecnología:</h3>
          <p></p>
        </div>
      </div>
    </div>
  </main>
  <style>
    img {
      width: 250px;
      height: auto;
    }
    .button-comprar {
      padding: 1rem;
      background-color: #53d196;
      border: 0.125rem solid #483a37;
      border-radius: 0.5rem;
      width: 100%;
    }
    .button-comprar:hover {
      background-color: #3ead79;
      transform: scale(1.05);
    }
    .card {
      background-color: #b1c2ba;
      border: dashed black 0.2rem;
      border-radius: 0.75rem;
      padding: 0rem 2rem 2rem 2rem;
      filter: drop-shadow(10px 10px 5px rgba(0, 0, 0, 0.34));
    }
    .card p,
    .card ul li {
      font-family: "Roboto", sans-serif;
      font-optical-sizing: auto;
      font-weight: 400;
      font-style: normal;
      font-variation-settings: "wdth" 75;
      text-align: justify;
    }
    #img-specie {
      height: 10rem;
      max-width: 10rem;
      aspect-ratio: cover;
      border: #483a37 dashed 0.2rem;
      border-radius: 0.5rem;
    }
    .specie-card {
      border-radius: 0.75rem;
      border: #483a37 dashed 0.25rem;
    }

    .img-description {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      text-align: justify;
      justify-content: start;
      align-items: start;
      filter: none;
    }

    .full-size {
      background-color: #7e8984;
      margin: 1rem;
      margin-top: 2rem;
      padding: 1rem;
      padding-top: 0.25rem;
    }

    @media only screen and (max-width: 600px) {
      .img-description,
      .wrap {
        flex-wrap: wrap;
      }
    }
  </style>
</Layout>
