<style>
	nav {
		position: fixed;
		top: 0;
		left: 30%;
		width: 33%;
		background-color: #483A37;
		color: white;
		width: 30rem;
		height: 2rem;
		clip-path: polygon(0% 0%, 100% 0%, 80% 100%, 20% 100%);
	}
	
	a{
		color: white;
	}

	ul{
		margin-top: 0.2rem;
		display: flex;
		align-content: top;

		justify-content: center;
		row-gap: 1rem;
		li{
			list-style: none;
			margin-right: 1rem;
			a{
				text-decoration: none;
				color: #ffffff;
				transition: color 0.3s ease;
			}
		}
	}

	/*
	#F26F5A rosa
	#6FB394 verde oscuro
	#5AF2AE verde claro
	#9D756F marron
	#64736C gris oscuro
	#483A37 marron oscuro
	*/
</style>
