---
import { SPECIES } from "../../dataBaseFake/species";

import Image from "astro/components/Image.astro";
---

<div id="container">
  <div class="card">
    <h1>Universo</h1>
    <p>
      Mi universo transcurre miles de años en el futuro, en una galaxia que está
      colisionando contra y seguirá durante miles de años.
    </p>
    <p>
      Las civilizaciones viven su mejor momento, pero ya ha habido otras que
      consiguieron su era dorada y ahora solo son restos espaciales que
      aventureros investigan en busca de tecnología olvidada.
    </p>
    <p>
      Las cuatro especies principales son los <b>Guppies</b>, <b
        >Pan Agon Glin</b
      >, <b>Zyndrak</b> y las <b>mantis</b>, pero en el futuro es posible que
      otras especies tomen relevancia.
    </p>
  </div>

  <section id="species">
    {
      SPECIES.map((specie) => (
        <div class="specie-card full-size">
          <h2>{specie.name}</h2>
          <div class="img-description">
            <Image id="img-specie" src={specie.image} alt={specie.name} />
            {Array.isArray(specie.description) ? (
              <div>
                {specie.description.map((desc) => (
                  <p>{desc}</p>
                ))}
                <a
                  href={`../species/${specie.name.toLowerCase().replaceAll(" ", "-")}`}
                >
                  Más sobre los {specie.name}
                </a>
              </div>
            ) : (
              <p>{specie.description}</p>
            )}
          </div>
        </div>
      ))
    }
  </section>
</div>

<style>
  h1 {
    font-size: 1.5rem;
  }
  .card {
    background-color: #b1c2ba;
    border: dashed black 0.2rem;
    border-radius: 0.75rem;
    padding: 0rem 2rem 2rem 2rem;
    filter: drop-shadow(10px 10px 5px rgba(0, 0, 0, 0.34));
  }
  .card p,
  .card ul li {
    font-family: "Roboto", sans-serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-style: normal;
    font-variation-settings: "wdth" 75;
    text-align: justify;
  }
  #img-specie {
    height: 10rem;
    max-width: 10rem;
    aspect-ratio: cover;
    border: #483a37 dashed 0.2rem;
    border-radius: 0.5rem;
  }
  .specie-card {
    border-radius: 0.75rem;
    border: #483a37 dashed 0.25rem;
  }

  .img-description {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    text-align: justify;
    justify-content: start;
    align-items: start;
    filter: none;
  }

  .full-size {
    background-color: #7e8984;
    margin: 1rem;
    margin-top: 2rem;
    padding: 1rem;
    padding-top: 0.25rem;
  }

  @media only screen and (max-width: 600px) {
    .img-description {
      flex-wrap: wrap;
    }
  }
</style>
