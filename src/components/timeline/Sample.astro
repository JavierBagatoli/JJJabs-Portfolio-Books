<div class="sample">
	<div id="mini_book" class="unvalible">
		<p>➤ Planificado</p>
	</div>
	<div id="mini_book" class="warning">
		<p>➤ En desarrollo</p>
	</div>
	<div id="mini_book">
		<p>➤ Disponible</p>
	</div>
</div>

<style>

	
	#mini_book{
		display: flex;
		background-color: #68a78e;
		border-radius: 0.4rem;
		flex-direction: row;
		padding-right: 0.5rem;
		gap: 0.5rem;
		width: auto;
		min-width: 220px;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.warning{
		background-color: #bcb291 !important;
	}
	
	.unvalible{
		background-color: #a0aca6 !important;
	}
	
	
	.sample{
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 0.5rem;

		div{
			padding: 0rem 0.5rem;
		}
	}


	@media screen and (max-width: 500px) {
		.sample{
			width: 100%;
			flex-direction: column;
			align-items: center;
		}
	}
</style>
