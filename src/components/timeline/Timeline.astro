---
import TimelineComponent from "./TimelineComponent.astro";
import { BOOKS_OCASO } from "../../dataBaseFake/Books";
import Sample from "./Sample.astro";

const librosAmanecer = [
  {
    date: "10.000",
    books: [
      {
        title: "Un Robo Más",
        icon: "corona",
        saga: "",
        description:
          "Comenzamos a trabajar en el proyecto de la línea de tiempo.",
      },
    ],
  },
  {
    date: "50.000",
    books: [
      {
        title: "No era solo un robo.",
        icon: "corona",
        saga: "",
        description:
          "Comenzamos a trabajar en el proyecto de la línea de tiempo.",
      },
    ],
  },
];

const librosOcaso = BOOKS_OCASO;
---

<div id="container">
  <h2>Linea del Tiempo</h2>
  <Sample />
  <h3>Amanecer (Fantasia)</h3>
  <TimelineComponent libros={librosAmanecer} />
  <h3>Ocaso (Cify)</h3>
  <TimelineComponent libros={librosOcaso} />
  <h3>Anochecer</h3>
  <TimelineComponent libros={[]} />
</div>

<style>
  body {
    background-color: #64736c;
  }
  #timeline {
    border-left: black 1px solid;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-left: 0.5rem;
  }
  #container {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    margin-top: 2rem;
    width: 100%;
  }
  #year-timeline {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    align-items: center;
    height: 100%;
  }
  #data-timeline {
    width: auto;
    gap: 1rem;
    border: none;
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    color: rgb(0, 0, 0);

    padding-right: 1rem;
    height: 3rem;
    gap: 0.5rem;
    Image,
    img {
      height: 3rem;
    }
  }
  #mini_book {
    display: flex;
    background-color: #f26f5a;
    border-radius: 0.4rem;
    flex-direction: row;
    padding-right: 0.5rem;
    gap: 0.5rem;
    width: auto;
  }

  @media screen and (max-width: 500px) {
    #container {
      margin-top: 0rem;
    }

    h2 {
      margin-top: 0rem;
      padding-top: 0rem;
    }
  }
</style>
