---
import { BOOKS_OCASO } from "../../dataBaseFake/Books";
import Book from "./Book.astro";


const items = BOOKS_OCASO;
---

<main id="container">
	{items?.map((item) => (
		item.books?.map((book) => (
				<Book id="book_container" book={book} />
			))
	))}
</main>

<style>
	body{
		background-color: #64736C;

	}
	#container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1rem;
		margin-top: 3rem;
	}
	/*
	#F26F5A rosa
	#6FB394 verde oscuro
	#5AF2AE verde claro
	#9D756F marron
	#64736C gris oscuro
	#483A37 marron oscuro
	*/
</style>
