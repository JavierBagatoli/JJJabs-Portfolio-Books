---
import Label from "./Label.astro";
const { img, isAvalible, saga, title, description, labels, urlRead } =
  Astro.props.book;
import Image from "astro/components/Image.astro";
import noAvalible from "../../../public/work-in-progress.png";
import { undefined } from "astro:schema";
---

<div id="book_background" class={isAvalible ? "" : "no_avalible"}>
  <section id="book_cover">
    <Image
      src={img ? img : noAvalible}
      alt="Book Cover"
      height="200"
      width="200"
    />
  </section>

  <section id="book_data">
    <div class="flex row" style={{ gap: "1rem" }}>
      {
        urlRead.length > 0 && (
          <div class="link-referal">
            <a href={urlRead}>Ir a leer</a>
          </div>
        )
      }
      <h2>
        {title}
        {saga.length > 2 && <span> - {saga}</span>}
      </h2>
    </div>
    <p id="description">{description}</p>
    <div id="label_list">
      {labels?.map((label: string) => <Label id="label" label={label} />)}
    </div>
  </section>
</div>

<style>
  .link-referal {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    height: 100%;
    transition: all 0.2s ease-in-out;
    filter: drop-shadow(3px 3px 8px rgba(0, 0, 0, 0.521));
    a {
      text-align: center;
      text-justify: center;
      text-decoration: none;
      color: white;
      background-color: rgb(29, 75, 59);
      height: fit-content;
      padding: 0.5rem;
    }
  }

  .link-referal:hover {
    transform: rotate(-5deg);
    filter: drop-shadow(3px 3px 0px rgba(0, 0, 0, 0.521));
  }

  #book_background {
    container-type: inline-size; /* permite medir su ancho */
    justify-content: start;
    display: flex;
    flex-direction: row;
    background-color: #5b776a !important;
    border: #483a37 dashed 0.25rem;
    border-radius: 0.75rem;
    margin: 0;
    padding: 0;

    /* width */
    ::-webkit-scrollbar {
      width: 10px;
    }

    /* Track */
    ::-webkit-scrollbar-track {
      background: #e9e3e3;
    }

    /* Handle */
    ::-webkit-scrollbar-thumb {
      background: #853333;
    }

    /* Handle on hover */
    ::-webkit-scrollbar-thumb:hover {
      background: #a84d4d;
    }
  }

  #book_background.no_avalible {
    background-color: #7b807d !important;

    #book_cover {
      display: flex;
      align-content: center;
      justify-content: center;
      justify-items: center;
      align-items: center;
      img {
        margin: 1rem;
        border: #483a37 dashed 0.25rem;
        filter: saturate(0.2);
      }
    }

    #label_list {
      #label {
        background-color: #cec7c7;
      }
    }
  }

  @media screen and (max-width: 650px) {
    #book_background {
      justify-content: center;
      flex-wrap: wrap;
      margin: 0rem 1rem;
    }

    h2 {
      margin: 0rem;
    }
  }

  #book_cover {
    display: flex;
    align-content: center;
    justify-content: center;
    justify-items: center;
    align-items: center;
    img {
      margin: 1rem;
      border: #483a37 dashed 0.25rem;
      border-radius: 0.5rem;
      margin: 0.5rem;
      filter: drop-shadow(10px 10px 5px rgba(0, 0, 0, 0.34));
    }
  }

  #book_data {
    display: flex;
    flex-direction: column;
    justify-content: top;
    padding: 1rem;
    color: white;
    #description {
      width: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 0;
    }
    #label_list {
      margin-top: 0.5rem;
      margin-bottom: 0.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
</style>
