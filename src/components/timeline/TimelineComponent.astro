---
const libros = Astro.props.libros as {
    date: string,
    books: {
		isAvalible?: boolean,
        title: string,
        description: string,
		saga: string,
		icon?: string,
		urlRead?: string,
		img?: string
        }[]
    }[];
---

<div>
	{libros.map((date) => (
		<div id="year-timeline">
			<section id="timeline">
				<p>{date.date} »</p>
			</section>
			<section id="data-timeline">
				{date.books.map((info) => (
					<div id="mini_book" class={info.isAvalible === undefined? "unvalible": !info.isAvalible ? "warning" : ""}>
						<img 
							id="signature_book"
							src={`/${info.icon}.png`}
							alt="Saga: Los Cinco Anillos" />
						<p class="dm-mono-light text-pc">{info.title}</p>
						
						{info.urlRead &&
							<a href={info.urlRead} target="_blank" rel="noopener noreferrer">
								<img
									id="redirect_to_reed_or_buy"
									src="/leer.png"
									alt="Ir a Leer o Comprar"
								/>
							</a>
						}
						<p class="dm-mono-light text-mobile">{info.title}</p>
					</div>
				))}
				
			</section>
		</div>
	))}
	
</div>

<style>
	.noImg{
		height: 50px;
		width: 50px;
	}
	#timeline {
		border-left: black 1px solid;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-left: 0.5rem;
		width:5.5rem;
	}
	#year-timeline{
		display: flex;
		flex-direction: row;
		gap: 1rem;
		padding-top: 0.3rem;
		align-items: center;
		height: 100%;
	}
	#data-timeline {
		width: auto;
		gap: 1rem;
		border: none;
		display: flex;
		flex-direction: row;
		gap: 0.5rem;
		color: rgb(0, 0, 0);

		padding-right: 1rem;
		height: 3rem;
		gap: 0.9rem;
		Image, img{
			height: 3rem;
			border-radius: 0.4rem 0 0 0.4rem;
			border-right: rgba(0, 0, 0, 0.274) 2px dashed;
		}
	}
	#mini_book{
		display: flex;
		background-color: #68a78e;
		border-radius: 0.4rem;
		flex-direction: row;
		padding-right: 0.5rem;
		gap: 0.5rem;
		width: auto;
		min-width: 220px;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.warning{
		background-color: #bcb291 !important;
	}
	
	.unvalible{
		background-color: #a0aca6 !important;
	}
	#signature_book, #redirect_to_reed_or_buy{
		height: 2rem !important;
		padding: 0.5rem;
		border-radius: 0 0.4rem 0.4rem 0;
	}
	#redirect_to_reed_or_buy{
		transition: 0.3s ease;
		border: none !important;
		padding-right: 0rem !important;
		border-left: rgba(0, 0, 0, 0.274) 2px dashed !important;
		animation: pulse 2s infinite;
	}
	#redirect_to_reed_or_buy:hover{
		cursor: pointer;
		transform: scale(1.2);
	}
	
	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.274);
		}
		70% {
			box-shadow: 0 0 0 10px rgba(0, 0, 0, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
		}
	}

	@media screen and (max-width: 500px) {
		.text-pc{
			display: none;
		}

		.text-mobile{
			display: flex;
			padding: 0rem 1rem 0rem 1rem;
			overflow: hidden; /* Hides the overflowed content */
			text-overflow: ellipsis;
			margin-top: 0rem;
			margin-bottom: 0rem;
			padding: 0.5rem;
			max-width: 12rem;
		}
		#mini_book{
			display: flex;
			flex-direction: row;
			flex-wrap:wrap;
		}
		#data-timeline{
			height: auto;
		}
		#redirect_to_reed_or_buy{
			border-left: none !important;
		}

		Image, img{
			border-bottom: rgba(0, 0, 0, 0.274) 2px dashed;;
		}

		#redirect_to_reed_or_buy{
			border-radius: 0 !important;
		}
	}

	@media screen and (min-width: 500px) {
		.text-pc{
			display: flex;
		}
		.text-mobile{
			display: none;
		}
	}

	/*
	#F26F5A rosa
	#6FB394 verde oscuro
	#5AF2AE verde claro
	#9D756F marron
	#64736C gris oscuro
	#483A37 marron oscuro
	*/
</style>
