---
const species = [
	{
		name: 'Humano',
		description: 'Los humanos son la especie dominante en el universo de Ocaso. Son conocidos por su adaptabilidad, creatividad y diversidad cultural. A lo largo de la historia, los humanos han colonizado numerosos planetas y han establecido una amplia variedad de culturas y civilizaciones.',
		image: './src/assets/species/Humano.png'
	},
	{
		name: 'Guppies',
		description: 'Los Zorath son una especie alienígena con una apariencia reptiliana. Son conocidos por su inteligencia avanzada y su habilidad para manipular la tecnología. Los Zorath tienen una sociedad altamente estructurada y valoran el conocimiento por encima de todo.',
		image: './src/assets/species/Guppies.png'
	},
	{
		name: 'Zyndrak',
		description: 'Los Elysians son una especie mística que habita en un planeta cubierto de bosques encantados. Son seres etéreos con habilidades mágicas y una conexión profunda con la naturaleza. Los Elysians son pacíficos por naturaleza y buscan mantener el equilibrio en su mundo.',
		image: './src/assets/species/Zyndrak.jpg'
	},
	{
		name: 'Sormiess',
		description: 'Los Sormiess son una especie mística que habita en un planeta cubierto de bosques encantados. Son seres etéreos con habilidades mágicas y una conexión profunda con la naturaleza. Los Sormiess son pacíficos por naturaleza y buscan mantener el equilibrio en su mundo.',
		image: './src/assets/species/Sormiess.jpg'
	},
	{
		name: 'Mantis',
		description: 'Son una especie muy primitiva que ha alcanzado la intelgencia gracias a un implante que se ubica en su cuello.',
		image: './src/assets/species/mantis.webp'
	},
	{
		name: 'Colmenas',
		description: 'Los Sormiess son una especie mística que habita en un planeta cubierto de bosques encantados. Son seres etéreos con habilidades mágicas y una conexión profunda con la naturaleza. Los Sormiess son pacíficos por naturaleza y buscan mantener el equilibrio en su mundo.',
		image: './src/assets/species/Sormiess.jpg'
	},
	{
		name: 'Forjados',
		description: 'Los Sormiess son una especie mística que habita en un planeta cubierto de bosques encantados. Son seres etéreos con habilidades mágicas y una conexión profunda con la naturaleza. Los Sormiess son pacíficos por naturaleza y buscan mantener el equilibrio en su mundo.',
		image: './src/assets/species/Sormiess.jpg'
	},
	{
		name: 'Medusas',
		description: 'Los Sormiess son una especie mística que habita en un planeta cubierto de bosques encantados. Son seres etéreos con habilidades mágicas y una conexión profunda con la naturaleza. Los Sormiess son pacíficos por naturaleza y buscan mantener el equilibrio en su mundo.',
		image: './src/assets/species/Sormiess.jpg'
	},
	{
		name: 'Forjados',
		description: 'Los Sormiess son una especie mística que habita en un planeta cubierto de bosques encantados. Son seres etéreos con habilidades mágicas y una conexión profunda con la naturaleza. Los Sormiess son pacíficos por naturaleza y buscan mantener el equilibrio en su mundo.',
		image: './src/assets/species/Sormiess.jpg'
	},
	{
		name: 'Triples',
		description: 'Son una especie que tuvo su epoca de grandeza, pero reiteradas traiciones les levaron a perder su propio sistema y ahora viven en tres colonias en planetas ajenos.',
		image: './src/assets/species/Sormiess.jpg'
	}
];
---

<main id="container">
	<h1>Universo</h1>
	<p>
		En esta sección se mostrará el universo literario de Ocaso, con sus diferentes planetas, especies, culturas, etc. Es un espacio para conocer el trasfondo de mis historias y descubrir nuevos detalles sobre el mundo que he creado.
	</p>

	<section id="species">
		{species.map((specie) => (
			<div class="specie-card">
				<h2>{specie.name}</h2>
				<div  class="img-description">
					<img id="img-specie" src={specie.image} alt={specie.name} />
					<p>{specie.description}</p>
				</div>
			</div>
		))}

	</section>
	
</main>

<style>
	body{
		background-color: #64736C;
	}
	#container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1rem;
		margin-top: 5rem;
	}
	#img-specie{
		height: 10rem;
		max-width: 100%;
		aspect-ratio: initial;
		border: #483A37 dashed 0.2rem;
		border-radius: 0.5rem;
	}
	.specie-card{
		padding-bottom: 2rem;
		border-bottom: #483a373f solid 0.2rem;
	}

	.img-description{
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 1rem;
		text-align: justify;
		justify-content: start;
		align-items: start;
	}
	@media only screen and (max-width: 600px)  {
		.img-description{
		flex-wrap: wrap;
	}
	}
	/*
	#F26F5A rosa
	#6FB394 verde oscuro
	#5AF2AE verde claro
	#9D756F marron
	#64736C gris oscuro
	#483A37 marron oscuro
	*/
</style>
