---
import { BOOKS_OCASO } from "../../dataBaseFake/Books";
import Book from "./Book.astro";

const items = BOOKS_OCASO;
---

<div id="container">
  <h1>Libros publicados y planeados</h1>
  {
    items?.map((item) =>
      item.books?.map((book) => <Book id="book_container" book={book} />),
    )
  }
</div>

<style>
  h1 {
    font-size: 1.5rem;
  }
  #container {
    width: 100%;
  }
</style>
