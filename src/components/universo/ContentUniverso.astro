---
import guppie from '../../assets/species/Guppie.jpg';
import panAgoGlin from '../../assets/species/Pan_Agon_Glin.jpg';
import zyndrak from '../../assets/species/Zyndrak.jpg';
import sormiess from '../../assets/species/Sormiess.jpg';
import amalgama from '../../assets/species/Amalgama.png';
import workInProgress from '../../assets/species/work-in-progress.png';

import Image from 'astro/components/Image.astro';

const species = [
	{
		name: 'Guppies',
		description: ['Los Guppies son una especie que ha evolucionado a la sombra de un planeta irradiado por una estrella de pulsar, y con la doble suerte de haber evolucionado lejos de los rayos de la estrella y donde algo puede llegar a vivir.','Sus cualidades son un carisma que se representa al hablar y cambiar de forma, su deseo por el poder económico y los tratos. Son una especie amiga o pueden llegar a ser tu mayor enemigo.','Pesan cerca de los 17 kilos, miden poco mas de medio metro de altura, sus cuerpos son moldeables y pueden caminar por cualquier superficie y gravedad. Son capaces de sobrevivir en la mayoría de los entornos.'],
		image: guppie
	},
	{
		name: 'Pan Agon Glin',
		description: ['Los Pan Agon Glin son la especie más reciente en alcanzar el espacio por cuenta propia, son jóvenes e intentan ganar su puesto como una civilización de pleno derecho, esforzándose para demostrar que pueden rendir igual que cualquier otra.', 'Son natos habitantes de los desiertos más peligrosos de la región galáctica, las tormentas de arena ocultan depredadores y las noches son capaces de congelar a la mayoría de los seres vivos.', 'Tiene una fuerte fe en El Ojo, su dios que los ha vigilado desde el inicio de sus tiempos. Y su moral les impide dejar a un compañero atrás. Sus cuerpos están acorazados y son asimétricos al igual que toda la vida de su planeta.'],
		image: panAgoGlin 
	},
	{
		name: 'Zyndrak',
		description: ['Los Zyndrak son una especie antigua y muy lastimada, su propio sol estalló consumiendo la superficie del planeta. Los únicos supervivientes fueron aquellos que pudieron ocultarse bajo la superficie y reconstruir su civilización.', 'Obligados a crecer en las cuevas, sus cuerpos comenzaron a ser bioluminiscentes y su cultura se adaptó a la supervivencia. Son de pocas palabras, pero gran conocimiento.', 'Destacan por su tamaño, fuerza y gran inteligencia. Son hábiles en cualquier trabajo que se propongan gracias a sus múltiples tentáculos.'],
		image: zyndrak
	},
	{
		name: 'Mantis',
		description: ['Las mantis fueron el animal dominante de su planeta, pero con la llegada de los reforjados. Estos le dieron un chip para mejorar su mente y que pudieran obedecer órdenes.', 'Por mucho tiempo han sido esclavos que no podían exigir su libertad, hasta ahora.'],
		image: workInProgress
	},
	{
		name: 'Humano',
		description: ['En progreso'],
		image: workInProgress
	},
	{
		name: 'Sormiess',
		description: ['Los Sormiess son la especie más egoísta del doble eje, si Dios existe. Debió darle piernas y brazos para evitar que existieran, pero no lo hizo.', 'Destacan por su inteligencia, su capacidad de traicionar y su astucia para conseguir información clave para los negocios.', 'Sus cuerpos son grandes, pesados y plagados de prótesis para interactuar con el mundo.'],
		image: sormiess
	},
	{
		name: 'Amalgamas',
		description: ['Las amalgamas son una especie creada para la terraformación de planetas, los continuos experimentos sobre estas criaturas les han otorgado una resistencia increíble.', 'No existe un patrón físico que distinga a las amalgamas, cada una es diferente.', 'Su comportamiento es sencillo, solo buscan defender sus territorios.'],
		image: amalgama
	},
	{
		name: 'Colmenas',
		description: ['En progreso'],
		image: workInProgress
	},
	{
		name: 'Forjados',
		description: 'En progreso',
		image: workInProgress
	},
	{
		name: 'Medusas',
		description: 'En progreso',
		image: workInProgress
	},
	{
		name: 'Forjados',
		description: 'En progreso',
		image: workInProgress
	},
	{
		name: 'Triples',
		description: 'En progreso',
		image: workInProgress
	}
];
---

<div id="container">
	<div class="card">
		<h2>Universo</h2>
		<p>
			Mi universo transcurre miles de años en el futuro, en una galaxia que esta colisionando contra y seguirá durante miles de años.
		</p>
		<p>
			Las civilizaciones viven su mejor momento, pero ya ha habido otras que consiguieron su era dorada y ahora solo son restos espaciales que aventureros investigan en busca de tecnología olvidada.
		</p>
		<p>
			Las cuatro especies principales son los <b>Guppies</b>, <b>Pan Agon Glin</b>, <b>Zyndrak</b> y las <b>mantis</b>, pero en el futuro es posible que otras especies tomen relevancia.	
		</p>		
	</div>

	<section id="species">
		{species.map((specie) => (
			<div class="specie-card">
				<h2>{specie.name}</h2>
				<div  class="img-description">
					<Image 
						id="img-specie"
						src={specie.image}
						alt={specie.name} />
					{
						Array.isArray(specie.description) ? (
							<div>{
								specie.description.map((desc) => (
									<p>{desc}</p>
								))}
							</div>
						) : (
							<p>{specie.description}</p>
						)
					}
				</div>
			</div>
		))}

	</section>
</div>

<style>
	.card{
        background-color: #b1c2ba;
        border: dashed black 2px;
        padding: 0rem 2rem 2rem 2rem;
        filter: drop-shadow(10px 10px 5px rgba(0, 0, 0, 0.34));
    }
	.card p, .card ul li{
        font-family: "Roboto", sans-serif;
        font-optical-sizing: auto;
        font-weight: 400;
        font-style: normal;
        font-variation-settings:
            "wdth" 75;
  		text-align: justify;
    }
	#img-specie{
		height: 10rem;
		max-width: 10rem;
		aspect-ratio: cover;
		border: #483A37 dashed 0.2rem;
		border-radius: 0.5rem;
	}
	.specie-card{
		padding-bottom: 2rem;
		border-bottom: #483a373f solid 0.2rem;
	}

	.img-description{
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 1rem;
		text-align: justify;
		justify-content: start;
		align-items: start;
	}
	@media only screen and (max-width: 600px)  {
		.img-description{
			flex-wrap: wrap;
		}
	}
</style>
